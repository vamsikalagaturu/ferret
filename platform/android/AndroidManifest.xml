<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.vamsikalagaturu.ferret">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- SMB and SFTP servers, and GitHub for updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- an update's APK handed to the system installer (the user still confirms each install) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="ferret"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:resizeableActivity="false"
        android:theme="@android:style/Theme.NoTitleBar">
        <activity
            android:name=".FerretActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="ferret" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the files app (Settings > Storage, and apps that open "the file manager") -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_FILES" />
            </intent-filter>
            <!-- a folder opened from another app (FerretActivity.takeOpenPath) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.document/directory" />
                <data android:mimeType="vnd.android.document/root" />
                <data android:mimeType="resource/folder" />
                <data android:mimeType="inode/directory" />
                <data android:mimeType="x-directory/normal" />
            </intent-filter>
        </activity>
        <provider
            android:name=".OpenProvider"
            android:authorities="io.github.vamsikalagaturu.ferret.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
